{
  "name": "jadu-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx src/db/migrate.ts && next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
