# Local development: SQLite file (no setup needed)
DATABASE_URL="file:./local.db"

# Production (Turso): get from https://app.turso.tech after creating a DB
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="..."

# Password gate — change this to anything memorable
CMS_PASSWORD="changeme"

# Used to sign the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET="dev-secret-replace-in-production-with-32-bytes-of-randomness"
